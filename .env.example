# ==============================================================================
# Google AI Development Workspace & MCP Initializer - Environment Template
# ==============================================================================
# Copy this file to .env and replace placeholder values with your credentials.
# NEVER commit your actual .env file or credentials to source control!
# ==============================================================================

# --- Google Cloud & Gemini Configuration ---
# Your Google Cloud Project ID (Required for Vertex AI / ADC workflows)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GCP_PROJECT_ID=your-gcp-project-id

# Google Cloud Region (e.g. global, us-central1, europe-west1)
GOOGLE_CLOUD_LOCATION=global

# Google GenAI Model Name (default: gemini-3.7-flash, fallback: gemini-2.5-flash)
GOOGLE_GENAI_MODEL=gemini-3.7-flash

# Use Enterprise Vertex AI SDK routing (default: True)
GOOGLE_GENAI_USE_ENTERPRISE=True

# Optional: Direct Gemini API Key (Alternative to Keyless Vertex AI ADC)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Service Account JSON path (Alternative to User ADC)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- Enterprise CA Certificate Configuration ---
# Automatically detected and populated by Phase 1; override if using a custom trust store
NODE_EXTRA_CA_CERTS=/etc/ssl/ca-bundle.pem
SSL_CERT_FILE=/etc/ssl/ca-bundle.pem
REQUESTS_CA_BUNDLE=/etc/ssl/ca-bundle.pem

# --- Model Context Protocol (MCP) Service Credentials ---

# GitHub (https://github.com)
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_personal_access_token
GITHUB_API_URL=https://api.github.com
